<!doctype html>
<html lang="pt-PT">
<head>
  <!-- Define a codificação para aceitar acentos e símbolos portugueses. -->
  <meta charset="utf-8" />

  <!-- Faz a página adaptar-se correctamente ao ecrã do telemóvel. -->
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Define a cor principal usada pelo browser quando a app é instalada. -->
  <meta name="theme-color" content="#111827" />

  <!-- Liga o manifesto PWA para permitir instalação no telemóvel. -->
  <link rel="manifest" href="./manifest.json" />

  <!-- Define o título da aplicação. -->
  <title>ATL Extractor V1</title>

  <!-- Carrega o Tesseract.js por CDN para fazer OCR gratuito no browser. -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

  <style>
    /* Define uma base visual simples e legível no telemóvel. */
    :root {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #111827;
      background: #f3f4f6;
    }

    /* Remove margens padrão e usa fundo cinzento claro. */
    body {
      margin: 0;
      background: #f3f4f6;
    }

    /* Cria uma área central com largura controlada. */
    .app {
      max-width: 1100px;
      margin: 0 auto;
      padding: 16px;
    }

    /* Estiliza o cabeçalho principal da app. */
    header {
      background: #111827;
      color: white;
      padding: 16px;
      border-radius: 16px;
      margin-bottom: 16px;
    }

    /* Remove margens excessivas do título. */
    h1 {
      margin: 0 0 6px;
      font-size: 1.4rem;
    }

    /* Mostra uma descrição curta com contraste reduzido. */
    .subtitle {
      margin: 0;
      color: #d1d5db;
      font-size: 0.95rem;
    }

    /* Cria cartões brancos para cada secção. */
    .card {
      background: white;
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }

    /* Organiza botões e controlos com espaçamento. */
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-top: 12px;
    }

    /* Estiliza botões principais. */
    button {
      border: 0;
      border-radius: 10px;
      padding: 10px 14px;
      background: #111827;
      color: white;
      font-weight: 650;
      cursor: pointer;
    }

    /* Estiliza botões secundários. */
    button.secondary {
      background: #e5e7eb;
      color: #111827;
    }

    /* Desactiva visualmente botões indisponíveis. */
    button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    /* Estiliza inputs e textareas. */
    input, textarea, select {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      padding: 9px;
      font: inherit;
      background: white;
    }

    /* Dá altura útil ao texto OCR bruto. */
    textarea {
      min-height: 150px;
      resize: vertical;
      white-space: pre-wrap;
    }

    /* Mostra a fotografia carregada sem rebentar o layout. */
    #preview {
      width: 100%;
      max-height: 480px;
      object-fit: contain;
      border-radius: 12px;
      background: #111827;
      margin-top: 12px;
      display: none;
    }

    /* Cria uma grelha de campos para os dados gerais. */
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    /* Em ecrãs pequenos, passa a grelha para uma coluna. */
    @media (max-width: 720px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    /* Permite rolar a tabela horizontalmente no telemóvel. */
    .table-wrap {
      overflow-x: auto;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
    }

    /* Define a tabela editável. */
    table {
      width: 100%;
      min-width: 1000px;
      border-collapse: collapse;
      background: white;
    }

    /* Estiliza células da tabela. */
    th, td {
      border-bottom: 1px solid #e5e7eb;
      border-right: 1px solid #e5e7eb;
      padding: 6px;
      text-align: left;
      vertical-align: top;
      font-size: 0.9rem;
    }

    /* Fixa um cabeçalho visual claro. */
    th {
      background: #f9fafb;
      font-weight: 700;
      white-space: nowrap;
    }

    /* Remove a borda direita na última coluna. */
    th:last-child, td:last-child {
      border-right: 0;
    }

    /* Faz os inputs da tabela ocuparem a célula toda. */
    td input {
      border: 0;
      border-radius: 6px;
      padding: 7px;
      background: #f9fafb;
    }

    /* Destaca mensagens de estado. */
    .status {
      padding: 10px 12px;
      border-radius: 10px;
      background: #eef2ff;
      color: #312e81;
      margin-top: 12px;
      font-size: 0.95rem;
      display: none;
    }

    /* Mostra erros de forma visível. */
    .error {
      background: #fee2e2;
      color: #7f1d1d;
    }

    /* Estiliza o bloco JSON final. */
    pre {
      margin: 0;
      padding: 12px;
      background: #111827;
      color: #e5e7eb;
      border-radius: 12px;
      overflow: auto;
      min-height: 160px;
    }

    /* Reduz visualmente notas auxiliares. */
    .note {
      color: #4b5563;
      font-size: 0.92rem;
      line-height: 1.35;
    }

    /* Cria um pequeno separador visual para cada label. */
    label {
      display: block;
      font-weight: 650;
      margin-bottom: 6px;
    }

    /* Estiliza campos pequenos de controlo. */
    .small-field {
      max-width: 140px;
    }
  </style>
</head>
<body>
  <!-- Container principal da aplicação. -->
  <main class="app">
    <!-- Cabeçalho com nome e objectivo da ferramenta. -->
    <header>
      <h1>ATL Extractor V1</h1>
      <p class="subtitle">Extrai dados básicos de Aircraft Technical Log, permite confirmar e gera JSON.</p>
    </header>

    <!-- Secção para tirar/carregar fotografia. -->
    <section class="card">
      <h2>1. Tirar ou carregar fotografia</h2>
      <p class="note">
        Usa uma fotografia com a folha inteira visível, o mais direita possível e com pouca sombra.
        Esta primeira versão usa OCR gratuito no browser e deve ser sempre confirmada manualmente.
      </p>

      <!-- Input de ficheiro com capture para abrir a câmara no telemóvel quando suportado. -->
      <input id="photoInput" type="file" accept="image/*" capture="environment" />

      <!-- Pré-visualização da imagem escolhida. -->
      <img id="preview" alt="Pré-visualização do Technical Log" />

      <!-- Botões de acção da secção de imagem. -->
      <div class="actions">
        <button id="runOcrBtn" disabled>Extrair por OCR</button>
        <button id="clearBtn" class="secondary">Limpar</button>
      </div>

      <!-- Mensagem de estado do OCR. -->
      <div id="status" class="status"></div>
    </section>

    <!-- Secção com texto OCR bruto para auditoria/correcção. -->
    <section class="card">
      <h2>2. Texto lido pela OCR</h2>
      <p class="note">
        Podes corrigir este texto antes de aplicar as heurísticas. Isto ajuda quando a OCR lê mal um número ou uma estação.
      </p>

      <!-- Área editável onde fica o texto extraído. -->
      <textarea id="ocrText" placeholder="O texto OCR aparece aqui..."></textarea>

      <!-- Botões para preencher dados a partir do texto ou manualmente. -->
      <div class="actions">
        <button id="parseBtn" class="secondary">Aplicar heurísticas</button>
        <button id="addLegBtn" class="secondary">Adicionar leg</button>
      </div>
    </section>

    <!-- Secção dos dados gerais da folha. -->
    <section class="card">
      <h2>3. Dados gerais</h2>

      <!-- Campos que pertencem à folha inteira e não a uma leg específica. -->
      <div class="grid">
        <div>
          <label for="technicalLogSerialNumber">Technical Log Serial Number</label>
          <input id="technicalLogSerialNumber" placeholder="ex.: 0432" />
        </div>
      </div>
    </section>

    <!-- Secção com tabela editável por leg. -->
    <section class="card">
      <h2>4. Tabela editável</h2>
      <p class="note">
        Confirma cada célula antes de gerar o JSON. Campos vazios ficam como <code>null</code>.
      </p>

      <!-- Tabela com scroll horizontal para ecrãs pequenos. -->
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Leg</th>
              <th>Refuel</th>
              <th>Depart</th>
              <th>Arrival</th>
              <th>Station Departure</th>
              <th>Station Arrival</th>
              <th>Off BLK</th>
              <th>A.T.D</th>
              <th>A.T.A</th>
              <th>On BLK</th>
              <th>PAX</th>
              <th>Trans</th>
              <th>Delay Cod.</th>
              <th>Acção</th>
            </tr>
          </thead>

          <!-- Corpo da tabela preenchido por JavaScript. -->
          <tbody id="legsTableBody"></tbody>
        </table>
      </div>

      <!-- Botões de confirmação e geração de JSON. -->
      <div class="actions">
        <button id="generateJsonBtn">Confirmar e gerar JSON</button>
        <button id="copyJsonBtn" class="secondary" disabled>Copiar JSON</button>
        <button id="downloadJsonBtn" class="secondary" disabled>Descarregar JSON</button>
      </div>
    </section>

    <!-- Secção com o JSON final. -->
    <section class="card">
      <h2>5. JSON final</h2>
      <pre id="jsonOutput">{}</pre>
    </section>
  </main>

  <script>
    // Guarda a imagem actualmente carregada em memória.
    let currentImageDataUrl = null;

    // Guarda o object URL usado para descarregar JSON.
    let currentJsonBlobUrl = null;

    // Selecciona elementos do DOM usados várias vezes.
    const photoInput = document.getElementById("photoInput");
    const preview = document.getElementById("preview");
    const runOcrBtn = document.getElementById("runOcrBtn");
    const clearBtn = document.getElementById("clearBtn");
    const statusBox = document.getElementById("status");
    const ocrText = document.getElementById("ocrText");
    const parseBtn = document.getElementById("parseBtn");
    const addLegBtn = document.getElementById("addLegBtn");
    const technicalLogSerialNumber = document.getElementById("technicalLogSerialNumber");
    const legsTableBody = document.getElementById("legsTableBody");
    const generateJsonBtn = document.getElementById("generateJsonBtn");
    const copyJsonBtn = document.getElementById("copyJsonBtn");
    const downloadJsonBtn = document.getElementById("downloadJsonBtn");
    const jsonOutput = document.getElementById("jsonOutput");

    // Define os campos por leg e os respectivos placeholders.
    const legFields = [
      { key: "leg", label: "Leg", placeholder: "1" },
      { key: "refuel", label: "Refuel", placeholder: "222" },
      { key: "depart", label: "Depart", placeholder: "260" },
      { key: "arrival", label: "Arrival", placeholder: "260" },
      { key: "station_departure", label: "Station Departure", placeholder: "BGC" },
      { key: "station_arrival", label: "Station Arrival", placeholder: "NAL" },
      { key: "off_blk", label: "Off BLK", placeholder: "13:15" },
      { key: "atd", label: "A.T.D", placeholder: "13:30" },
      { key: "ata", label: "A.T.A", placeholder: "13:40" },
      { key: "on_blk", label: "On BLK", placeholder: "13:45" },
      { key: "pax", label: "PAX", placeholder: "6" },
      { key: "trans", label: "Trans", placeholder: "0" },
      { key: "delay_code", label: "Delay Cod.", placeholder: "93" }
    ];

    // Cria quatro legs vazias ao arrancar, porque o formulário costuma ter várias linhas.
    const legs = [createEmptyLeg(1), createEmptyLeg(2), createEmptyLeg(3), createEmptyLeg(4)];

    // Desenha a tabela inicial.
    renderLegsTable();

    // Regista o service worker para permitir instalação PWA e cache básico.
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register("./sw.js").catch((error) => {
          console.warn("Não foi possível registar o service worker:", error);
        });
      });
    }

    // Converte uma string vazia em null, mantendo valores preenchidos.
    function emptyToNull(value) {
      const clean = String(value ?? "").trim();
      return clean === "" ? null : clean;
    }

    // Cria um objecto vazio para uma leg específica.
    function createEmptyLeg(legNumber) {
      return {
        leg: String(legNumber),
        refuel: "",
        depart: "",
        arrival: "",
        station_departure: "",
        station_arrival: "",
        off_blk: "",
        atd: "",
        ata: "",
        on_blk: "",
        pax: "",
        trans: "",
        delay_code: ""
      };
    }

    // Mostra uma mensagem de estado na interface.
    function setStatus(message, isError = false) {
      statusBox.textContent = message;
      statusBox.classList.toggle("error", isError);
      statusBox.style.display = message ? "block" : "none";
    }

    // Normaliza texto OCR para facilitar as pesquisas por regex.
    function normaliseText(text) {
      return String(text || "")
        .replace(/[|]/g, " ")
        .replace(/[“”]/g, '"')
        .replace(/[’]/g, "'")
        .replace(/[^\S\r\n]+/g, " ")
        .trim();
    }

    // Tenta encontrar o Technical Log Serial Number no texto OCR.
    function extractTechnicalLogSerial(text) {
      const clean = normaliseText(text);

      // Procura padrões comuns perto das palavras "serial number".
      const serialMatch =
        clean.match(/serial\s*number[^0-9]{0,30}([0-9]{3,6})/i) ||
        clean.match(/technical\s*log[^0-9]{0,40}([0-9]{3,6})/i) ||
        clean.match(/\b0[0-9]{3,5}\b/);

      // Devolve o primeiro número encontrado ou texto vazio.
      return serialMatch ? serialMatch[1] || serialMatch[0] : "";
    }

    // Extrai horas no formato HH:MM ou H.MM de uma linha OCR.
    function extractTimesFromLine(line) {
      const matches = String(line).match(/\b([0-2]?[0-9])[:.hH]([0-5][0-9])\b/g) || [];

      // Normaliza as horas para HH:MM.
      return matches.map((value) => {
        const parts = value.replace(/[hH.]/g, ":").split(":");
        const hour = parts[0].padStart(2, "0");
        const minute = parts[1].padStart(2, "0");
        return `${hour}:${minute}`;
      });
    }

    // Extrai números inteiros de uma linha OCR.
    function extractNumbersFromLine(line) {
      return String(line).match(/\b\d{1,4}\b/g) || [];
    }

    // Extrai códigos de estação com três ou quatro letras maiúsculas.
    function extractStationCodesFromLine(line) {
      const candidates = String(line).toUpperCase().match(/\b[A-Z]{3,4}\b/g) || [];

      // Remove palavras frequentes que não são estações.
      const blocked = new Set(["LOG", "PAX", "LEG", "ATA", "ATD", "BLK", "OFF", "ON", "NIL", "THE", "AND", "CREW"]);

      // Filtra candidatos que parecem estações.
      return candidates.filter((code) => !blocked.has(code));
    }

    // Tenta extrair legs a partir do texto OCR bruto.
    function extractLegsHeuristically(text) {
      const clean = normaliseText(text);
      const lines = clean.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
      const extracted = [];

      // Percorre cada linha para detectar conjuntos de dados que pareçam uma perna de voo.
      for (const line of lines) {
        const times = extractTimesFromLine(line);
        const stations = extractStationCodesFromLine(line);
        const numbers = extractNumbersFromLine(line);

        // Considera uma linha como candidata quando há pelo menos duas estações ou duas horas.
        const looksLikeLeg = stations.length >= 2 || times.length >= 2;

        // Ignora linhas sem indícios suficientes.
        if (!looksLikeLeg) {
          continue;
        }

        // Cria uma leg com o que for possível extrair.
        const leg = createEmptyLeg(extracted.length + 1);

        // Preenche estações quando existirem.
        leg.station_departure = stations[0] || "";
        leg.station_arrival = stations[1] || "";

        // Preenche horas pela ordem típica: off block, ATD, ATA, on block.
        leg.off_blk = times[0] || "";
        leg.atd = times[1] || "";
        leg.ata = times[2] || "";
        leg.on_blk = times[3] || "";

        // Usa os primeiros três números maiores como possível fuel: refuel/depart/arrival.
        const fuelNumbers = numbers.filter((n) => Number(n) >= 20 && Number(n) <= 5000);
        leg.refuel = fuelNumbers[0] || "";
        leg.depart = fuelNumbers[1] || "";
        leg.arrival = fuelNumbers[2] || "";

        // Tenta encontrar PAX em números pequenos.
        const smallNumbers = numbers.filter((n) => Number(n) >= 0 && Number(n) <= 99);
        leg.pax = smallNumbers[0] || "";
        leg.trans = smallNumbers[1] || "";

        // Guarda no máximo seis legs para evitar lixo OCR.
        if (extracted.length < 6) {
          extracted.push(leg);
        }
      }

      return extracted;
    }

    // Desenha a tabela com base no array legs.
    function renderLegsTable() {
      legsTableBody.innerHTML = "";

      // Cria uma linha de tabela para cada leg.
      legs.forEach((leg, index) => {
        const row = document.createElement("tr");

        // Cria uma célula editável para cada campo.
        legFields.forEach((field) => {
          const cell = document.createElement("td");
          const input = document.createElement("input");

          // Associa o input ao campo correspondente.
          input.value = leg[field.key] ?? "";
          input.placeholder = field.placeholder;
          input.dataset.index = String(index);
          input.dataset.field = field.key;

          // Actualiza o modelo de dados sempre que o utilizador edita.
          input.addEventListener("input", (event) => {
            const rowIndex = Number(event.target.dataset.index);
            const key = event.target.dataset.field;
            legs[rowIndex][key] = event.target.value;
          });

          cell.appendChild(input);
          row.appendChild(cell);
        });

        // Cria botão para remover a leg.
        const actionCell = document.createElement("td");
        const removeButton = document.createElement("button");
        removeButton.textContent = "Remover";
        removeButton.className = "secondary";
        removeButton.type = "button";

        // Remove a leg seleccionada e volta a desenhar a tabela.
        removeButton.addEventListener("click", () => {
          legs.splice(index, 1);
          renderLegsTable();
        });

        actionCell.appendChild(removeButton);
        row.appendChild(actionCell);
        legsTableBody.appendChild(row);
      });
    }

    // Lê a fotografia seleccionada e mostra a pré-visualização.
    photoInput.addEventListener("change", () => {
      const file = photoInput.files && photoInput.files[0];

      // Sai se não houver ficheiro.
      if (!file) {
        return;
      }

      // Usa FileReader para converter a imagem para data URL.
      const reader = new FileReader();

      // Quando a leitura termina, guarda e mostra a imagem.
      reader.onload = () => {
        currentImageDataUrl = reader.result;
        preview.src = currentImageDataUrl;
        preview.style.display = "block";
        runOcrBtn.disabled = false;
        setStatus("Imagem carregada. Podes iniciar a extracção por OCR.");
      };

      // Inicia a leitura do ficheiro.
      reader.readAsDataURL(file);
    });

    // Executa OCR com Tesseract.js sobre a fotografia carregada.
    runOcrBtn.addEventListener("click", async () => {
      if (!currentImageDataUrl) {
        setStatus("Carrega primeiro uma fotografia.", true);
        return;
      }

      // Desactiva o botão para evitar execuções duplicadas.
      runOcrBtn.disabled = true;
      setStatus("OCR em curso. Isto pode demorar alguns segundos no telemóvel...");

      try {
        // Executa o OCR em português e inglês para lidar com formulário misto.
        const result = await Tesseract.recognize(currentImageDataUrl, "eng+por", {
          logger: (message) => {
            // Mostra progresso aproximado ao utilizador.
            if (message.status && typeof message.progress === "number") {
              const pct = Math.round(message.progress * 100);
              setStatus(`${message.status}: ${pct}%`);
            }
          }
        });

        // Coloca o texto lido na textarea.
        ocrText.value = result.data.text || "";

        // Aplica heurísticas automaticamente depois da OCR.
        applyHeuristics();

        // Informa o utilizador de que deve confirmar os campos.
        setStatus("OCR concluída. Confirma os campos antes de gerar o JSON.");
      } catch (error) {
        console.error(error);
        setStatus("Erro ao executar OCR. Confirma a ligação à internet na primeira utilização e tenta novamente.", true);
      } finally {
        // Reactiva o botão depois do processo terminar.
        runOcrBtn.disabled = false;
      }
    });

    // Aplica heurísticas ao texto OCR e preenche campos quando possível.
    function applyHeuristics() {
      const text = ocrText.value;

      // Extrai o serial number da folha.
      const serial = extractTechnicalLogSerial(text);
      if (serial) {
        technicalLogSerialNumber.value = serial;
      }

      // Tenta extrair legs do texto.
      const extractedLegs = extractLegsHeuristically(text);

      // Só substitui a tabela se houver dados minimamente plausíveis.
      if (extractedLegs.length > 0) {
        legs.splice(0, legs.length, ...extractedLegs);
        renderLegsTable();
      }
    }

    // Permite aplicar heurísticas manualmente após editar o texto OCR.
    parseBtn.addEventListener("click", () => {
      applyHeuristics();
      setStatus("Heurísticas aplicadas. Confirma a tabela manualmente.");
    });

    // Adiciona uma nova leg vazia no fim da tabela.
    addLegBtn.addEventListener("click", () => {
      legs.push(createEmptyLeg(legs.length + 1));
      renderLegsTable();
    });

    // Limpa a app para começar uma nova folha.
    clearBtn.addEventListener("click", () => {
      currentImageDataUrl = null;
      photoInput.value = "";
      preview.removeAttribute("src");
      preview.style.display = "none";
      runOcrBtn.disabled = true;
      ocrText.value = "";
      technicalLogSerialNumber.value = "";
      legs.splice(0, legs.length, createEmptyLeg(1), createEmptyLeg(2), createEmptyLeg(3), createEmptyLeg(4));
      renderLegsTable();
      jsonOutput.textContent = "{}";
      copyJsonBtn.disabled = true;
      downloadJsonBtn.disabled = true;
      setStatus("");
    });

    // Constrói o JSON final a partir dos campos confirmados.
    function buildPayload() {
      return {
        technical_log_serial_number: emptyToNull(technicalLogSerialNumber.value),
        legs: legs.map((leg) => ({
          leg: emptyToNull(leg.leg),
          refuel: emptyToNull(leg.refuel),
          depart: emptyToNull(leg.depart),
          arrival: emptyToNull(leg.arrival),
          station_departure: emptyToNull(leg.station_departure),
          station_arrival: emptyToNull(leg.station_arrival),
          off_blk: emptyToNull(leg.off_blk),
          atd: emptyToNull(leg.atd),
          ata: emptyToNull(leg.ata),
          on_blk: emptyToNull(leg.on_blk),
          pax: emptyToNull(leg.pax),
          trans: emptyToNull(leg.trans),
          delay_code: emptyToNull(leg.delay_code)
        }))
      };
    }

    // Gera o JSON final depois da confirmação visual.
    generateJsonBtn.addEventListener("click", () => {
      const payload = buildPayload();
      const json = JSON.stringify(payload, null, 2);

      // Mostra o JSON na interface.
      jsonOutput.textContent = json;

      // Activa botões de cópia e download.
      copyJsonBtn.disabled = false;
      downloadJsonBtn.disabled = false;

      // Prepara o ficheiro JSON para download.
      if (currentJsonBlobUrl) {
        URL.revokeObjectURL(currentJsonBlobUrl);
      }

      // Cria um Blob com o JSON final.
      const blob = new Blob([json], { type: "application/json" });
      currentJsonBlobUrl = URL.createObjectURL(blob);

      setStatus("JSON gerado. Podes copiar ou descarregar.");
    });

    // Copia o JSON final para o clipboard.
    copyJsonBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(jsonOutput.textContent);
        setStatus("JSON copiado para a área de transferência.");
      } catch (error) {
        console.error(error);
        setStatus("Não foi possível copiar automaticamente. Selecciona o JSON manualmente.", true);
      }
    });

    // Descarrega o JSON final como ficheiro local.
    downloadJsonBtn.addEventListener("click", () => {
      if (!currentJsonBlobUrl) {
        return;
      }

      // Usa o serial number no nome do ficheiro quando existir.
      const serial = technicalLogSerialNumber.value.trim() || "sem-serial";
      const filename = `atl-${serial}.json`;

      // Cria uma âncora temporária para iniciar o download.
      const link = document.createElement("a");
      link.href = currentJsonBlobUrl;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
    });
  </script>
</body>
</html>
